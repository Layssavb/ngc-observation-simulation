    "\n",
    "    alt = altitude(obj[\"Dec\"], HA)\n",
    "\n",
    "    alt_deg = alt * 180 / np.pi\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Air Mass\n",
    "    # ------------------------------------------------------\n",
    "    X = air_mass(alt_deg)\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Remove values below the horizon\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    alt_deg[alt_deg < 0] = np.nan\n",
    "    X[alt_deg < 0] = np.nan\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
