    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ==========================================================\n",
    "# COMPARATIVE ASTRONOMICAL OBSERVATION SIMULATION\n",
    "# ==========================================================\n",
    "#\n",
    "# This script compares the observational conditions of\n",
    "# multiple NGC galaxies throughout the night.\n",
    "#\n",
    "# The program computes:\n",
    "#\n",
    "#   • Object altitude\n",
    "#   • Air mass\n",
    "#   • Visibility intervals\n",
    "#   • Temporal evolution of observational conditions\n",
    "#\n",
    "# Comparative plots are generated to identify:\n",
    "#\n",
    "#   • Best observing targets\n",
    "#   • Highest culmination objects\n",
    "#   • Lowest air mass conditions\n",
    "#   • Optimal observing windows\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# OBJECT PARAMETERS\n",
    "# ==========================================================\n",
    "#\n",
    "# Each object contains:\n",
    "#\n",
    "#   • Right Ascension (RA)\n",
    "#   • Declination (Dec)\n",
    "#   • Plot color\n",
    "#\n",
    "# Units:\n",
    "#\n",
    "#   • RA  -> hours\n",
    "#   • Dec -> degrees\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "objects = {\n",
    "\n",
    "    \"NGC 10\": {\n",
    "\n",
    "        \"RA\": 0 + 9/60 + 56.4/3600,\n",
    "        \"Dec\": -33 - 42/60 - 34/3600,\n",
    "\n",
    "        \"color\": \"red\"\n",
    "    },\n",
    "\n",
    "    \"NGC 38\": {\n",
    "\n",
    "        \"RA\": 0 + 13/60 + 8.1/3600,\n",
    "        \"Dec\": -5 - 26/60 - 4/3600,\n",
    "\n",
    "        \"color\": \"brown\"\n",
    "    },\n",
    "\n",
    "    \"NGC 47\": {\n",
    "\n",
    "        \"RA\": 0 + 15/60 + 52.0/3600,\n",
    "        \"Dec\": -7 - 1/60 - 5/3600,\n",
    "\n",
    "        \"color\": \"blue\"\n",
    "    }\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# CONVERSION TO RADIANS\n",
    "# ==========================================================\n",
    "#\n",
    "# Trigonometric calculations require radian units.\n",
    "#\n",
    "# Conversion:\n",
    "#\n",
    "#   RA:\n",
    "#       24h  → 2π rad\n",
    "#\n",
    "#   Dec:\n",
    "#       180° → π rad\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "for obj in objects.values():\n",
    "\n",
    "    obj[\"RA\"] *= np.pi / 12\n",
    "    obj[\"Dec\"] *= np.pi / 180\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# OBSERVATORY PARAMETERS\n",
    "# ==========================================================\n",
    "#\n",
    "# Observatory:\n",
    "# Cerro Tololo Inter-American Observatory\n",
    "#\n",
    "# Latitude strongly affects:\n",
    "#\n",
    "#   • Maximum altitude\n",
    "#   • Visibility duration\n",
    "#   • Air mass\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "latitude = -30.165 * np.pi / 180\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# TIME ARRAYS\n",
    "# ==========================================================\n",
    "#\n",
    "# LT  -> Local Time\n",
    "# UT  -> Universal Time\n",
    "# LST -> Local Sidereal Time\n",
    "#\n",
    "# The simulation interval corresponds to:\n",
    "#\n",
    "#       19:00 → 06:00\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "LT = np.linspace(19, 30, 300)\n",
    "\n",
    "# Approximate Chilean local time conversion\n",
    "UT = LT + 4\n",
    "\n",
    "# Approximate Local Sidereal Time\n",
    "LST0 = 0.465\n",
    "LST = LST0 + (LT - 24) * 1.0027379\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# FUNCTIONS\n",
    "# ==========================================================\n",
    "\n",
    "def altitude(dec, HA):\n",
    "\n",
    "    \"\"\"\n",
    "    Compute object altitude above the horizon.\n",
    "\n",
    "    Astronomical relation:\n",
    "\n",
    "        sin(h) =\n",
    "            sin(phi) sin(dec)\n",
    "            + cos(phi) cos(dec) cos(HA)\n",
    "\n",
    "    where:\n",
    "\n",
    "        h   -> altitude\n",
    "        phi -> observatory latitude\n",
    "        dec -> declination\n",
    "        HA  -> hour angle\n",
    "\n",
    "    \"\"\"\n",
    "\n",
    "    return np.arcsin(\n",
    "        np.sin(latitude) * np.sin(dec)\n",
    "        + np.cos(latitude) * np.cos(dec) * np.cos(HA)\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "def air_mass(alt_deg):\n",
    "\n",
    "    \"\"\"\n",
    "    Compute air mass using the standard\n",
    "    secant approximation.\n",
    "\n",
    "    Important interpretation:\n",
    "\n",
    "        • X ≈ 1:\n",
    "            object near zenith\n",
    "\n",
    "        • Larger X:\n",
    "            stronger atmospheric extinction\n",
    "\n",
    "        • X > 2:\n",
    "            usually poor observational quality\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    alt_deg : array\n",
    "        Altitude in degrees.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    X : array\n",
    "        Air mass values.\n",
    "    \"\"\"\n",
    "\n",
    "    # Convert altitude to radians\n",
    "    alt_rad = np.radians(alt_deg)\n",
    "\n",
    "    # Standard approximation\n",
    "    X = 1 / np.sin(alt_rad)\n",
    "\n",
    "    # Remove non-physical values\n",
    "    X[alt_deg <= 0] = np.nan\n",
    "\n",
    "    # Avoid extreme divergences near horizon\n",
    "    X[X > 10] = np.nan\n",
    "\n",
    "    return X\n",
