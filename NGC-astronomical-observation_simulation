    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ==========================================================\n",
    "# ASTRONOMICAL OBSERVATION SIMULATION\n",
    "# ==========================================================\n",
    "#\n",
    "# This script simulates the observational conditions for\n",
    "# selected NGC galaxies using astronomical relations\n",
    "# commonly applied in observational astronomy.\n",
    "#\n",
    "# The program computes:\n",
    "#\n",
    "#   • Object altitude above the horizon\n",
    "#   • Air mass\n",
    "#   • Hour angle\n",
    "#   • Visibility evolution during the night\n",
    "#\n",
    "# In addition, the script generates observational graphs:\n",
    "#\n",
    "#   • Altitude vs Local Time\n",
    "#   • Altitude vs Local Sidereal Time\n",
    "#   • Altitude vs Universal Time\n",
    "#   • Air Mass vs Time\n",
    "#\n",
    "# These quantities are fundamental in observation planning,\n",
    "# since they directly affect atmospheric extinction,\n",
    "# image quality, and observational efficiency.\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# OBJECT PARAMETERS\n",
    "# ==========================================================\n",
    "#\n",
    "# Right Ascension (RA):\n",
    "# Angular coordinate measured along the celestial equator.\n",
    "#\n",
    "# Declination (Dec):\n",
    "# Angular coordinate analogous to terrestrial latitude.\n",
    "#\n",
    "# Units:\n",
    "#   • RA  -> hours\n",
    "#   • Dec -> degrees\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "objects = {\n",
    "\n",
    "    \"NGC 10\": {\n",
    "        \"RA\": 0 + 9/60 + 56.4/3600,\n",
    "        \"Dec\": -33 - 42/60 - 34/3600\n",
    "    },\n",
    "\n",
    "    \"NGC 38\": {\n",
    "        \"RA\": 0 + 13/60 + 8.1/3600,\n",
    "        \"Dec\": -5 - 26/60 - 4/3600\n",
    "    },\n",
    "\n",
    "    \"NGC 47\": {\n",
    "        \"RA\": 0 + 15/60 + 52.0/3600,\n",
    "        \"Dec\": -7 - 1/60 - 5/3600\n",
    "    }\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# CONVERSION TO RADIANS\n",
    "# ==========================================================\n",
    "#\n",
    "# Trigonometric functions in NumPy use radians.\n",
    "#\n",
    "# Conversion factors:\n",
    "#\n",
    "#   RA:\n",
    "#       24h  → 2π rad\n",
    "#\n",
    "#   Dec:\n",
    "#       180° → π rad\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "for obj in objects.values():\n",
    "\n",
    "    obj[\"RA\"] *= np.pi / 12\n",
    "    obj[\"Dec\"] *= np.pi / 180\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# OBSERVATORY PARAMETERS\n",
    "# ==========================================================\n",
    "#\n",
    "# Observatory:\n",
    "# Cerro Tololo Inter-American Observatory\n",
    "#\n",
    "# Latitude:\n",
    "# Important because object altitude depends directly\n",
    "# on the observer's geographical latitude.\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "latitude = -30.165 * np.pi / 180\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# TIME ARRAYS\n",
    "# ==========================================================\n",
    "#\n",
    "# LT  -> Local Time\n",
    "# UT  -> Universal Time\n",
    "# LST -> Local Sidereal Time\n",
    "#\n",
    "# The simulation covers the interval from:\n",
    "#\n",
    "#       19:00 → 06:00\n",
    "#\n",
    "# ==========================================================\n",
    "\n",
    "LT = np.linspace(19, 30, 200)\n",
    "\n",
    "# Approximate Chilean local time conversion\n",
    "UT = LT + 4\n",
    "\n",
    "# Approximate Local Sidereal Time\n",
    "LST0 = 0.465\n",
    "LST = LST0 + (LT - 24) * 1.0027379\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# FUNCTIONS\n",
    "# ==========================================================\n",
    "\n",
    "def altitude(dec, HA):\n",
    "\n",
    "    \"\"\"\n",
    "    Compute object altitude above the horizon.\n",
    "\n",
    "    Formula:\n",
    "\n",
    "        sin(h) =\n",
    "            sin(phi) sin(dec)\n",
    "            + cos(phi) cos(dec) cos(HA)\n",
    "\n",
    "    where:\n",
    "\n",
    "        h   -> altitude\n",
    "        phi -> observatory latitude\n",
    "        dec -> declination\n",
    "        HA  -> hour angle\n",
    "\n",
    "    \"\"\"\n",
    "\n",
    "    return np.arcsin(\n",
    "        np.sin(latitude) * np.sin(dec)\n",
    "        + np.cos(latitude) * np.cos(dec) * np.cos(HA)\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "def air_mass(alt):\n",
    "\n",
    "    \"\"\"\n",
    "    Compute air mass using the secant approximation.\n",
    "\n",
    "    Air mass quantifies how much atmosphere the light\n",
    "    crosses before reaching the telescope.\n",
    "\n",
    "    Important observations:\n",
    "\n",
    "        • X ≈ 1  -> object near zenith\n",
    "        • Larger X -> stronger atmospheric effects\n",
    "        • X > 2  -> usually poor observational quality\n",
    "\n",
    "    \"\"\"\n",
    "\n",
    "    zenith_distance = np.pi / 2 - alt\n",
    "\n",
    "    return 1 / np.cos(zenith_distance)\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# MAIN OBSERVATIONAL LOOP\n",
    "# ==========================================================\n",
    "\n",
    "for name, obj in objects.items():\n",
    "\n",
    "    # ======================================================\n",
    "    # HOUR ANGLE\n",
    "    # ======================================================\n",
    "    #\n",
    "    # HA measures the angular distance between the object\n",
    "    # and the local meridian.\n",
    "    #\n",
    "    # HA = 0:\n",
    "    #   Object at culmination (maximum altitude)\n",
    "    #\n",
    "    # ======================================================\n",
    "\n",
    "    HA = (LST * np.pi / 12) - obj[\"RA\"]\n",
    "\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # ALTITUDE CALCULATION\n",
    "    # ======================================================\n",
    "\n",
    "    alt = altitude(obj[\"Dec\"], HA)\n",
    "\n",
    "    # Convert radians → degrees\n",
    "    alt_deg = alt * 180 / np.pi\n",
    "\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # AIR MASS\n",
    "    # ======================================================\n",
    "\n",
    "    X = air_mass(alt)\n",
    "\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # REMOVE VALUES BELOW HORIZON\n",
    "    # ======================================================\n",
    "    #\n",
    "    # Negative altitudes correspond to objects below\n",
    "    # the horizon and therefore not observable.\n",
    "    #\n",
    "    # ======================================================\n",
    "\n",
    "    alt_deg[alt_deg < 0] = np.nan\n",
    "    X[alt_deg < 0] = np.nan\n",
    "\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # ALTITUDE GRAPHS\n",
    "    # ======================================================\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Altitude vs Local Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(LT, alt_deg, color='red')\n",
    "\n",
    "    plt.xlabel(\"Local Time (LT)\")\n",
    "    plt.ylabel(\"Altitude (degrees)\")\n",
    "\n",
    "    plt.title(f\"{name} — Altitude vs Local Time\")\n",
    "\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Altitude vs Local Sidereal Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(LST, alt_deg, color='blue')\n",
    "\n",
    "    plt.xlabel(\"Local Sidereal Time (LST)\")\n",
    "    plt.ylabel(\"Altitude (degrees)\")\n",
    "\n",
    "    plt.title(f\"{name} — Altitude vs LST\")\n",
    "\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Altitude vs Universal Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(UT, alt_deg, color='green')\n",
    "\n",
    "    plt.xlabel(\"Universal Time (UT)\")\n",
    "    plt.ylabel(\"Altitude (degrees)\")\n",
    "    plt.title(f\"{name} — Altitude vs UT\")\n",
    "\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    # ======================================================\n",
    "    # AIR MASS GRAPHS\n",
    "    # ======================================================\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Air Mass vs Local Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(LT, X, color='orange')\n",
    "\n",
    "    plt.xlabel(\"Local Time (LT)\")\n",
    "    plt.ylabel(\"Air Mass (X)\")\n",
    "\n",
    "    plt.title(f\"{name} — Air Mass vs Local Time\")\n",
    "    plt.axhline(1.55, linestyle='--')\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Air Mass vs Local Sidereal Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(LST, X, color='purple')\n",
    "\n",
    "    plt.xlabel(\"Local Sidereal Time (LST)\")\n",
    "    plt.ylabel(\"Air Mass (X)\")\n",
    "\n",
    "    plt.title(f\"{name} — Air Mass vs LST\")\n",
    "    plt.axhline(1.55, linestyle='--')\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    # ------------------------------------------------------\n",
    "    # Air Mass vs Universal Time\n",
    "    # ------------------------------------------------------\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(UT, X, color='pink')\n",
    "\n",
    "    plt.xlabel(\"Universal Time (UT)\")\n",
    "    plt.ylabel(\"Air Mass (X)\")\n",
    "    plt.axhline(1.55, linestyle='--')\n",
    "    plt.title(f\"{name} — Air Mass vs UT\")\n",
    "\n",
    "    plt.grid()\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "# ==========================================================\n",
    "# FINAL OBSERVATIONS\n",
    "# ==========================================================\n",
    "#\n",
    "# The generated graphs allow identification of:\n",
    "#\n",
    "#   • Best observing intervals\n",
    "#   • Object culmination times\n",
    "#   • Lowest air mass conditions\n",
    "#   • Visibility duration\n",
    "#\n",
    "# Observations performed at larger altitudes and\n",
    "# lower air masses generally provide:\n",
    "#\n",
    "#   • Better image quality\n",
    "#   • Lower atmospheric extinction\n",
    "#   • Higher observational precision\n",
    "#\n",
    "# =========================================================="
